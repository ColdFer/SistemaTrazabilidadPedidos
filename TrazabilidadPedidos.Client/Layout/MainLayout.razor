@inherits LayoutComponentBase
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="app-container">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="main-container">
        <header class="topbar">
            <div class="topbar-left">
                <h1>NovaTec</h1>
                <span>Tienda tecnológica con gestión de clientes, inventario y despachos</span>
            </div>

            <div class="user-area">
                <div class="user-avatar">@UserInitial</div>

                <div class="user-details">
                    <strong>@userName</strong>
                    <span>@userRole</span>
                </div>
            </div>
        </header>

        <main class="main-content">
            @Body
        </main>
    </div>
</div>

@code {
    private string userName = "Usuario";
    private string userRole = "";

    private string UserInitial =>
        string.IsNullOrWhiteSpace(userName) ? "U" : userName[..1].ToUpper();

    private string GetRoleDisplayName(string role) => role switch
    {
        "Administrator" => "Administrador",
        "Operator" => "Operador",
        "Customer" => "Cliente",
        "DeliveryDriver" => "Repartidor",
        _ => role
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            userName = await JS.InvokeAsync<string>("localStorage.getItem", "userName") ?? "Usuario";
            var rawRole = await JS.InvokeAsync<string>("localStorage.getItem", "userRole") ?? "";
            userRole = GetRoleDisplayName(rawRole);
            StateHasChanged();
        }
    }
}