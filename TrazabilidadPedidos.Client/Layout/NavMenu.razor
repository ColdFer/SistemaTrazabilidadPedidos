@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

<style>
    .nav-brand {
        height: 90px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0 20px;
        border-bottom: 1px solid rgba(255,255,255,.10);
        text-align: center;
    }

    .nav-brand-text {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .nav-brand-text strong {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: 0.5px;
    }

    .nav-brand-text span {
        color: #c9d6e5;
        font-size: 13px;
        margin-top: 4px;
    }

    .nav-menu {
        padding: 12px 14px;
        flex: 1;
        overflow-y: auto;
    }

    .nav-menu-title {
        color: #8fa8c3;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        padding: 0 12px 8px 12px;
        margin-top: 12px;
    }

    .nav-menu-title:first-child {
        margin-top: 0;
    }

    .nav-item {
        display: block !important;
        padding: 11px 14px;
        margin-bottom: 4px;
        border-radius: 10px;
        text-decoration: none;
        color: #eaf2fb;
        font-size: 14px;
        font-weight: 500;
        transition: all .15s ease;
        cursor: pointer;
        width: 100%;
    }

    .nav-item:hover {
        background: rgba(255,255,255,.08);
        color: #ffffff;
    }

    .nav-item.active {
        background: #2563eb;
        color: #ffffff;
    }

    .nav-footer {
        width: 100%;
        padding: 14px;
        border-top: 1px solid rgba(255,255,255,.10);
    }

    .nav-logout {
        width: 100%;
        border: 0;
        background: transparent;
        color: #eaf2fb;
        padding: 11px 14px;
        border-radius: 10px;
        display: block;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        text-align: left;
    }

    .nav-logout:hover {
        background: rgba(255,255,255,.08);
        color: #ffffff;
    }
</style>

<div class="nav-brand">
    <div class="nav-brand-text">
        <strong>NovaTec</strong>
        <span>Gestion de Pedidos</span>
    </div>
</div>

<div class="nav-menu">

    @if (userRole == "Administrator")
    {
        <div class="nav-menu-title">MENU</div>

        <a class="nav-item" href="dashboard">Dashboard</a>
        <a class="nav-item" href="reportes">Reportes</a>
        <a class="nav-item" href="usuarios">Usuarios</a>
        <a class="nav-item" href="clientes">Clientes</a>
        <a class="nav-item" href="inventario">Inventario</a>
        <a class="nav-item" href="pedidos">Pedidos</a>
        <a class="nav-item" href="pagos/pendientes">Pagos</a>
        <a class="nav-item" href="despachos">Despachos</a>
        <a class="nav-item" href="configuracion/roles">Roles y Permisos</a>
    }
    else if (userRole == "Operator")
    {
        <div class="nav-menu-title">MENU</div>

        <a class="nav-item" href="dashboard">Dashboard</a>
        <a class="nav-item" href="clientes">Clientes</a>
        <a class="nav-item" href="inventario">Inventario</a>
        <a class="nav-item" href="pedidos">Pedidos</a>
        <a class="nav-item" href="pagos/pendientes">Pagos</a>
        <a class="nav-item" href="despachos">Despachos</a>
    }
    else if (userRole == "Customer")
    {
        <div class="nav-menu-title">MENU</div>

        <a class="nav-item" href="cliente/inicio">Inicio</a>
        <a class="nav-item" href="catalogo">Catalogo</a>
        <a class="nav-item" href="carrito">Mi carrito</a>
        <a class="nav-item" href="mis-pedidos">Mis pedidos</a>
        <a class="nav-item" href="mi-perfil">Mi perfil</a>
    }
    else if (userRole == "DeliveryDriver")
    {
        <div class="nav-menu-title">MENU</div>

        <a class="nav-item" href="mis-despachos">Mis despachos</a>
    }
</div>

<div class="nav-footer">
    <button class="nav-logout" @onclick="Logout">
        Cerrar sesion
    </button>
</div>

@code {
    private string userRole = string.Empty;

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userName");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userRole");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userId");
        Navigation.NavigateTo("/login", true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            userRole = await JS.InvokeAsync<string>(
                "localStorage.getItem", "userRole") ?? string.Empty;

            StateHasChanged();
        }
    }
}
